# Postgres — used to assemble DATABASE_URL automatically (see app/core/config.py).
# Point these at your local Postgres install (e.g. the default "postgres" superuser
# in pgAdmin) — leave DATABASE_URL below unset/commented so it's built from these.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=event_vendor_platform

# Only set this if you want to override the assembled connection string directly
# (docker-compose.yml does this, pointing at the "db" container instead of localhost).
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/event_vendor_platform

# Security
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# App
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
ENVIRONMENT=development
